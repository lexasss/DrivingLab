<Window x:Class="ClientExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientExample"
        xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Client Example"
        Height="450"
        Width="800">
    <Window.Resources>
        <Style x:Key="Device" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Data" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="Mark" TargetType="Grid">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Label Style="{StaticResource Device}">Leap Motion</Label>
                <WrapPanel>
                    <Grid Style="{StaticResource Mark}">
                        <Ellipse Fill="Red"
                                 Visibility="{Binding IsLeapMotionAvailable, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.NotCollapsedInstance}}"/>
                        <Ellipse Fill="Green"
                                 Visibility="{Binding IsLeapMotionAvailable, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.CollapsedInstance}}"/>
                    </Grid>
                    <Label>Available</Label>
                </WrapPanel>
                <WrapPanel>
                    <Grid Style="{StaticResource Mark}">
                        <Ellipse Fill="Red"
                                 Visibility="{Binding IsLeapMotionConnected, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.NotCollapsedInstance}}"/>
                        <Ellipse Fill="Green"
                                 Visibility="{Binding IsLeapMotionConnected, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.CollapsedInstance}}"/>
                    </Grid>
                    <Label>Connected</Label>
                </WrapPanel>
                <WrapPanel>
                    <Grid Style="{StaticResource Mark}">
                        <Ellipse Fill="Red"
                                 Visibility="{Binding IsHandVisible, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.NotCollapsedInstance}}"/>
                        <Ellipse Fill="Green"
                                 Visibility="{Binding IsHandVisible, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.CollapsedInstance}}"/>
                    </Grid>
                    <Label>Hand visible</Label>
                </WrapPanel>
                <WrapPanel>
                    <Grid Style="{StaticResource Mark}">
                        <Ellipse Fill="Red"
                                 Visibility="{Binding IsHandClose, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.NotCollapsedInstance}}"/>
                        <Ellipse Fill="Green"
                                 Visibility="{Binding IsHandClose, Mode=OneWay,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.CollapsedInstance}}"/>
                    </Grid>
                    <Label>Hand is close</Label>
                </WrapPanel>
                <Button Margin="8"
                        IsEnabled="{Binding IsLeapMotionConnected}"
                        Command="{Binding ToggleLeapMotionDataReadingCommand}"
                        Content="Toggle data streaming"/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding LeapMotionData, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
