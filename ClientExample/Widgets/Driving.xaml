<UserControl x:Class="ClientExample.Widgets.Driving"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <conv:InvertBooleanConverter x:Key="InvertBoolean"/>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="Slider" BasedOn="{StaticResource MaterialDesign3.MaterialDesignSlider}">
                    <Setter Property="Maximum" Value="1.0"/>
                    <Setter Property="TickFrequency" Value="0.001"/>
                    <Setter Property="SmallChange" Value="0.001"/>
                    <Setter Property="Foreground" Value="#FF5E6CB7"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
            </StackPanel.Resources>
            <Label Style="{StaticResource Device}"
                   Content="Driving"/>
            <StackPanel Margin="4">
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Margin="8,0"
                                   Text="Available"/>
                <Separator/>
                <Label HorizontalAlignment="Center"
                       Content="Connection status"/>
                <UniformGrid Margin="4,0">
                    <widgets:Indicator IsOn="{Binding IsBaseConnected, Mode=OneWay}"
                                       Text="Base"/>
                    <widgets:Indicator IsOn="{Binding IsWheelConnected, Mode=OneWay}"
                                       Text="Wheel"/>
                    <widgets:Indicator IsOn="{Binding ArePedalsConnected, Mode=OneWay}"
                                       Text="Pedals"/>
                    <widgets:Indicator IsOn="{Binding AreActivePedalsConnected, Mode=OneWay}"
                                       Text="Act. pedals"/>
                </UniformGrid>
                <Separator/>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsAvailable}"
                                  IsChecked="{Binding IsStreaming}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Stream data"/>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsAvailable}"
                                  IsChecked="{Binding IsLogging}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Log data"/>
                </WrapPanel>
                <Separator/>
                <Canvas HorizontalAlignment="Stretch"
                        Width="200"
                        Height="156">
                    <Canvas.Resources>
                        <Style TargetType="widgets:Indicator">
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                        <Style x:Key="Shape" TargetType="Path">
                            <Setter Property="Fill" Value="#FFDEDEDE"/>
                            <Setter Property="Stroke" Value="DarkGray"/>
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Setter Property="StrokeLineJoin" Value="Round"/>
                            <Setter Property="Stretch" Value="Fill"/>
                        </Style>
                        <Style x:Key="TriangleTop" TargetType="Path" BasedOn="{StaticResource Shape}">
                            <Setter Property="Width" Value="80"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Data">
                                <Setter.Value>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0.5,0"
                                                    IsClosed="True">
                                            <LineSegment Point="1, 1" />
                                            <LineSegment Point="0, 1" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="TriangleBottom" TargetType="Path" BasedOn="{StaticResource TriangleTop}">
                            <Setter Property="Data">
                                <Setter.Value>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0.5,1"
                                                    IsClosed="True">
                                            <LineSegment Point="1, 0" />
                                            <LineSegment Point="0, 0" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="PaddleLeft" TargetType="Path" BasedOn="{StaticResource Shape}">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Data">
                                <Setter.Value>
                                    <PathGeometry>
                                        <PathFigure StartPoint="1,1"
                                                    IsClosed="True">
                                            <ArcSegment Point="1, 0.5" Size="1,1" SweepDirection="Clockwise" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="PaddleRight" TargetType="Path" BasedOn="{StaticResource PaddleLeft}">
                            <Setter Property="Data">
                                <Setter.Value>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,0"
                                                    IsClosed="True">
                                            <ArcSegment Point="0, 1" Size="1,1" SweepDirection="Clockwise" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Canvas.Resources>

                    <Path Style="{StaticResource TriangleTop}"
                          Canvas.Left="2"
                          Canvas.Top="0"/>
                    <Path Style="{StaticResource TriangleTop}"
                          Canvas.Left="110"
                          Canvas.Top="0"/>
                    <Path Style="{StaticResource TriangleBottom}"
                          Canvas.Left="2"
                          Canvas.Top="114"/>
                    <Path Style="{StaticResource TriangleBottom}"
                          Canvas.Left="110"
                          Canvas.Top="114"/>
                    <Path Style="{StaticResource PaddleLeft}"
                          Canvas.Left="0"
                          Canvas.Top="48"/>
                    <Path Style="{StaticResource PaddleRight}"
                          Canvas.Left="174"
                          Canvas.Top="48"/>

                    <widgets:Indicator IsOn="{Binding Buttons[0].IsPressed, Mode=OneWay}"
                                       Canvas.Left="16"
                                       Canvas.Top="16"/>
                    <widgets:Indicator IsOn="{Binding Buttons[1].IsPressed, Mode=OneWay}"
                                       Canvas.Left="32"
                                       Canvas.Top="0"/>
                    <widgets:Indicator IsOn="{Binding Buttons[2].IsPressed, Mode=OneWay}"
                                       Canvas.Left="48"
                                       Canvas.Top="16"/>
                    <widgets:Indicator IsOn="{Binding Buttons[3].IsPressed, Mode=OneWay}"
                                       Canvas.Right="48"
                                       Canvas.Top="16"/>
                    <widgets:Indicator IsOn="{Binding Buttons[4].IsPressed, Mode=OneWay}"
                                       Canvas.Right="32"
                                       Canvas.Top="0"/>
                    <widgets:Indicator IsOn="{Binding Buttons[5].IsPressed, Mode=OneWay}"
                                       Canvas.Right="16"
                                       Canvas.Top="16"/>
                    <widgets:Indicator IsOn="{Binding Buttons[6].IsPressed, Mode=OneWay}"
                                       Canvas.Left="16"
                                       Canvas.Top="112"/>
                    <widgets:Indicator IsOn="{Binding Buttons[7].IsPressed, Mode=OneWay}"
                                       Canvas.Left="32"
                                       Canvas.Top="128"/>
                    <widgets:Indicator IsOn="{Binding Buttons[8].IsPressed, Mode=OneWay}"
                                       Canvas.Left="48"
                                       Canvas.Top="112"
                                       StrokeThickness="2"/>
                    <widgets:Indicator IsOn="{Binding Buttons[9].IsPressed, Mode=OneWay}"
                                       Canvas.Right="32"
                                       Canvas.Top="128"/>
                    <widgets:Indicator IsOn="{Binding Buttons[10].IsPressed, Mode=OneWay}"
                                       Canvas.Right="16"
                                       Canvas.Top="112"/>
                    <widgets:PointOfView Canvas.Left="115"
                                         Canvas.Top="105"
                                         Value="{Binding PointOfView}"
                                         Height="30"
                                         Width="30"
                                         Margin="4"/>
                    <widgets:Indicator IsOn="{Binding Buttons[11].IsPressed, Mode=OneWay}"
                                       Canvas.Right="48"
                                       Canvas.Top="112"
                                       StrokeThickness="2"/>
                    <widgets:Indicator IsOn="{Binding Buttons[12].IsPressed, Mode=OneWay}"
                                       Canvas.Left="0"
                                       Canvas.Top="64"/>
                    <widgets:Indicator IsOn="{Binding Buttons[13].IsPressed, Mode=OneWay}"
                                       Canvas.Right="0"
                                       Canvas.Top="64"/>
                    <Slider Canvas.Left="68"
                            Canvas.Top="96"
                            Value="{Binding Sliders[1].Value}"
                            Orientation="Vertical"
                            Height="50"/>
                    <Slider Canvas.Right="82"
                            Canvas.Top="96"
                            Value="{Binding Sliders[2].Value}"
                            Orientation="Vertical"
                            Height="50"/>
                    <Label Canvas.Left="72"
                            Canvas.Top="50"
                            Content="Wheel"/>
                    <Slider Canvas.Left="28"
                            Canvas.Top="66"
                            Value="{Binding Sliders[0].Value}"
                            Width="132"/>
                </Canvas>
                <UniformGrid Columns="4"
                             HorizontalAlignment="Center">
                    <UniformGrid.Resources>
                        <Style TargetType="Slider" BasedOn="{StaticResource MaterialDesign3.MaterialDesignSlider}">
                            <Setter Property="Maximum" Value="1.0"/>
                            <Setter Property="TickFrequency" Value="0.001"/>
                            <Setter Property="SmallChange" Value="0.001"/>
                            <Setter Property="Foreground" Value="#FF5E6CB7"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Orientation" Value="Vertical"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </UniformGrid.Resources>
                    <StackPanel>
                        <Label Content="Brake"/>
                        <Slider Value="{Binding Sliders[3].Value}"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Throttle"/>
                        <Slider Value="{Binding Sliders[4].Value}"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Ac. Br."/>
                        <Slider Grid.Row="1" Grid.Column="1"
                                Value="{Binding Sliders[5].Value}"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Ac. Thr."/>
                        <Slider Grid.Row="1" Grid.Column="1"
                                Value="{Binding Sliders[6].Value}"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
