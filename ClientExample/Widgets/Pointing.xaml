<UserControl x:Class="ClientExample.Widgets.Pointing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientExample"
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:pt="clr-namespace:Pointing;assembly=Core"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <conv:InvertBooleanConverter x:Key="InvertBoolean"/>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Label Style="{StaticResource Device}"
                   Content="Pointing"/>
            <StackPanel Margin="4">
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Text="Available"/>
                <Separator/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Device"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}"
                              DisplayMemberPath="Description"
                              IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBoolean}}"
                              SelectedItem="{Binding Device, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignPaperDarkButton}"
                            Content="⟳"
                            Padding="6,0"
                            Margin="4,0,0,0"
                            FontSize="20"
                            IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBoolean}}"
                            Command="{Binding UpdateDeviceListCommand}"/>
                </Grid>
                <widgets:Indicator IsOn="{Binding IsConnected, Mode=OneWay}"
                                   Text="Connected"/>
                <Separator/>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsConnected}"
                                  IsChecked="{Binding IsStreaming}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Stream data"/>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsConnected}"
                                  IsChecked="{Binding IsLogging}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Log data"/>
                </WrapPanel>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
