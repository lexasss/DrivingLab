<UserControl x:Class="ClientExample.Widgets.Pointing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientExample"
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:pt="clr-namespace:Pointing;assembly=Core"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <conv:InvertBooleanConverter x:Key="InvertBoolean"/>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Label Style="{StaticResource Device}"
                   Content="Pointing"/>
            <StackPanel Margin="4">
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Text="Available"/>
                <Separator/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Device"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Devices}"
                              DisplayMemberPath="Description"
                              IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBoolean}}"
                              SelectedItem="{Binding Device, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignPaperDarkButton}"
                            Content="⟳"
                            Padding="6,0"
                            Margin="4,0,0,0"
                            FontSize="20"
                            IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBoolean}}"
                            Command="{Binding UpdateDeviceListCommand}"/>
                </Grid>
                <widgets:Indicator IsOn="{Binding IsConnected, Mode=OneWay}"
                                   Text="Connected"
                                   HorizontalAlignment="Center"/>
                <Separator/>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsConnected}"
                                  IsChecked="{Binding IsStreaming}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Stream data"/>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsConnected}"
                                  IsChecked="{Binding IsLogging}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Log data"/>
                </WrapPanel>
                <Separator/>
                <StackPanel>
                    <Label Content="Buttons"
                           HorizontalContentAlignment="Center"/>
                    <UniformGrid Columns="6">
                        <widgets:Indicator IsOn="{Binding Buttons[0].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[1].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[2].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[3].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[4].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[5].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[6].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[7].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[8].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[9].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[10].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[11].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[12].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[13].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[14].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[15].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[16].IsPressed, Mode=OneWay}"/>
                        <widgets:Indicator IsOn="{Binding Buttons[17].IsPressed, Mode=OneWay}"/>
                    </UniformGrid>
                </StackPanel>
                <Separator/>
                <UniformGrid Columns="3">
                    <StackPanel>
                        <Label Content="Sliders"
                               HorizontalContentAlignment="Center"/>
                        <UniformGrid Columns="2" Height="60">
                            <Slider Value="{Binding Sliders[0].Value}"
                                    Orientation="Vertical"
                                    Maximum="1.0"
                                    SmallChange="0.001"
                                    TickFrequency="0.001"
                                    Margin="4"/>
                            <Slider Value="{Binding Sliders[1].Value}"
                                    Orientation="Vertical"
                                    Maximum="1.0"
                                    SmallChange="0.001"
                                    TickFrequency="0.001"
                                    Margin="4"/>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Dial"
                               HorizontalContentAlignment="Center"/>
                        <widgets:PointOfView Value="{Binding PointOfView}"
                                            Height="50"
                                            Width="50"
                                            Margin="4"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Point"
                               HorizontalContentAlignment="Center"/>
                        <widgets:Joystick Value="{Binding Point}"
                                            Height="50"
                                            Width="50"
                                            Margin="4"/>
                    </StackPanel>
                </UniformGrid>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
