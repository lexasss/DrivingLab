<UserControl x:Class="ClientExample.Indicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientExample"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="30"
             d:DesignWidth="200"
             x:Name="root">
    <WrapPanel>
        <Grid Width="12"
              Height="12"
              VerticalAlignment="Center"
              Margin="8,0">
            <Ellipse Fill="#FFC12323"
                     Visibility="{Binding IsOn,
                                          ElementName=root,
                                          Converter={x:Static conv:BooleanToVisibilityConverter.NotCollapsedInstance}}"/>

            <Ellipse Fill="#FF4FCC2D"
                     Visibility="{Binding IsOn,
                                          ElementName=root,
                                          Converter={x:Static conv:BooleanToVisibilityConverter.CollapsedInstance}}"/>
        </Grid>

        <Label Content="{Binding Text, ElementName=root}" />
    </WrapPanel>
</UserControl>
