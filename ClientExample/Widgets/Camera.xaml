<UserControl x:Class="ClientExample.Widgets.Camera"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientExample"
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <local:ValueToBooleanConverter x:Key="ValueToBoolean"/>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="widgets:Indicator">
                    <Setter Property="Margin" Value="8,0"/>
                </Style>
            </StackPanel.Resources>
            <Label Style="{StaticResource Device}"
                   Content="Camera"/>
            <StackPanel Margin="4">
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Text="Available"/>
                <Separator/>
                <Grid IsEnabled="{Binding IsAvailable}">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Camera"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding Cameras}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding Camera, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Camera, Converter={StaticResource ValueToBoolean}}" Value="False">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Stream"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding Streams}"
                              DisplayMemberPath="Description"
                              SelectedItem="{Binding Stream, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Camera, Converter={StaticResource ValueToBoolean}}" Value="True"/>
                                            <Condition Binding="{Binding Stream, Converter={StaticResource ValueToBoolean}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <Label Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Output"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="4,0"
                                 Text="{Binding VideoFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="filename">
                            <TextBox.ToolTip>
                                <TextBlock>
                                        <Run Text="If MP4 expension is not specified,"/>
                                        <LineBreak/>
                                        <Run Text="then it will be added automatically."/>
                                </TextBlock>
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignPaperDarkButton}"
                                Content="↑"
                                Padding="12,0"
                                FontSize="20"
                                Command="{Binding SetVideoFileNameCommand}"/>
                    </Grid>
                    <widgets:Indicator Grid.Row="3" Grid.Column="1"
                                       IsOn="{Binding IsReadyToRecord, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       Text="Ready"/>
                </Grid>
                <Separator/>
                <WrapPanel IsEnabled="{Binding IsAvailable}">
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsRecording}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Recording video"/>
                </WrapPanel>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
