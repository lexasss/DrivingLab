<UserControl x:Class="ClientExample.Widgets.TensionR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:ClientExample"
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:tr="clr-namespace:TensionR;assembly=Core"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <md:InvertBooleanConverter x:Key="InvertBoolean"/>
        <local:ValueToBooleanConverter x:Key="ValueToBoolean"/>

        <ObjectDataProvider x:Key="SideSource"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="tr:Side" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Label Style="{StaticResource Device}"
                   Content="TensionR Belt"/>
            <StackPanel Margin="4">
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Text="Available"/>
                <widgets:Indicator IsOn="{Binding IsConnected, Mode=OneWay}"
                                   Text="Connected"/>
                <Separator/>
                <Grid Margin="4"
                      IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBoolean}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource OptionName}"
                           Content="Port"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding ComPorts}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding ComPort}"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource MaterialDesignPaperDarkButton}"
                            Content="⯺"
                            Padding="8,4,8,0"
                            Margin="4,0,0,0"
                            Height="28"
                            IsEnabled="{Binding ComPort, Converter={StaticResource ValueToBoolean}}"
                            Command="{Binding ConnectCommand}">
                    </Button>
                </Grid>
                <Separator/>
                <WrapPanel>
                    <ToggleButton IsChecked="{Binding IsEnabled}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAvailable}" Value="True"/>
                                            <Condition Binding="{Binding IsConnecting}" Value="False"/>
                                            <Condition Binding="{Binding IsConnected}" Value="True"/>
                                            <Condition Binding="{Binding IsCalibrating}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Enabled"/>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsEnabled="{Binding IsConnected}"
                                  IsChecked="{Binding IsLogging}">
                    </ToggleButton>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Log data"/>
                </WrapPanel>
                <Separator/>
                <Button Content="{Binding CalibrateButtonText}"
                        Command="{Binding CalibrateCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAvailable}" Value="True"/>
                                        <Condition Binding="{Binding IsConnecting}" Value="False"/>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                        <Condition Binding="{Binding IsCalibrating}" Value="False"/>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Separator/>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAvailable}" Value="True"/>
                                        <Condition Binding="{Binding IsConnecting}" Value="False"/>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                        <Condition Binding="{Binding IsCalibrated}" Value="True"/>
                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Label Content="Tension"
                           HorizontalContentAlignment="Center"/>
                    <Slider Minimum="0"
                            Maximum="64"
                            Margin="4,0,4,8"
                            Value="{Binding Tension}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource SideSource}}"
                              SelectedItem="{Binding Side}"
                              HorizontalContentAlignment="Center"/>
                </StackPanel>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
