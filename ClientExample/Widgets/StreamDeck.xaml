<UserControl x:Class="ClientExample.Widgets.StreamDeck"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:ClientExample"
             xmlns:widgets="clr-namespace:ClientExample.Widgets"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="200">
    
    <UserControl.Resources>
        <conv:InvertBooleanConverter x:Key="InvertBoolean"/>
        <local:EnumToBooleanConverter x:Key="EnumToBoolean"/>
    </UserControl.Resources>
    
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Label Style="{StaticResource Device}">
                <TextBlock>
                    <Run>Stream Deck</Run>
                    <Run Text="{Binding KeyboardSize, Mode=OneWay}"/>
                </TextBlock>
            </Label>
            <StackPanel Margin="4">
                <StackPanel.Resources>
                    <Style TargetType="widgets:Indicator">
                        <Setter Property="Margin" Value="4,0"/>
                    </Style>
                </StackPanel.Resources>
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Text="Available"/>
                <widgets:Indicator IsOn="{Binding IsConnected, Mode=OneWay}"
                                   Text="Connected"/>
                <Separator/>
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Filename, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="filename">
                            <TextBox.ToolTip>
                                <TextBlock>
                                    <Run Text="An image file to set as a key icon."/>
                                    <LineBreak/>
                                    <Run Text="Supported types are PNG and JPG."/>
                                    <LineBreak/>
                                    <Run Text="Use either the absolute path,"/>
                                    <LineBreak/>
                                    <Run Text="or the path relative to the 'Deck' folder"/>
                                    <LineBreak/>
                                    <Run Text="in the server application root folder"/>
                                </TextBlock>
                            </TextBox.ToolTip>
                        </TextBox>
                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignPaperDarkButton}"
                                Content="↑"
                                Padding="12,0"
                                FontSize="20"
                                IsEnabled="{Binding CanUploadFile}"
                                Command="{Binding UploadFileCommand}"/> 
                    </Grid>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center"
                           Content="Brightness"/>
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Margin="8"
                            IsEnabled="{Binding IsConnected}"
                            Value="{Binding Brightness}"/>
                </Grid>
                <Separator/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label VerticalAlignment="Center"
                           Content="Key"/>
                    <ComboBox Grid.Column="1"
                              Margin="8,0"
                              Width="42"
                              ItemsSource="{Binding KeyIds}"
                              SelectedValue="{Binding KeyId}"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding KeyFileNameOrColor, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="filename or RGB">
                        <TextBox.ToolTip>
                            <TextBlock>
                                <Run Text="An image file to set as a key icon."/>
                                <LineBreak/>
                                <Run Text="Alternatively, an RGB color with values"/>
                                <LineBreak/>
                                <Run Text="from 0 to 255 separated by a comma."/>
                            </TextBlock>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
                <Button Margin="4"
                        IsEnabled="{Binding CanSetKey}"
                        Content="{Binding SetKeyButtonText}"
                        Command="{Binding SetKeyCommand}"/>
                <Separator/>
                <UniformGrid Columns="5"
                             HorizontalAlignment="Center"
                             IsEnabled="{Binding IsConnected}">
                    <widgets:Indicator IsOn="{Binding Keys[0].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[1].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[2].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[3].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[4].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[5].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[6].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[7].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[8].IsPressed, Mode=OneWay}"/>
                    <widgets:Indicator IsOn="{Binding Keys[9].IsPressed, Mode=OneWay}"/>
                </UniformGrid>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
