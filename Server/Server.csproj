<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Tuni.SmartEyeTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LeapCSharp.NET4.5, Version=3.2.1.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\libs\x32\LeapCSharp.NET4.5.dll</HintPath>
    </Reference>
    <Reference Include="Tobii.EyeX.Client.Net20">
      <HintPath>..\libs\x32\Tobii.EyeX.Client.Net20.dll</HintPath>
    </Reference>
    <Reference Include="Tobii.Gaze.Core.Net">
      <HintPath>..\libs\x32\Tobii.Gaze.Core.Net.dll</HintPath>
    </Reference>
    <Reference Include="EyeXFramework">
      <HintPath>..\libs\x32\EyeXFramework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Visible="false" Include="..\libs\x32\LeapC.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Visible="false" Include="..\libs\x32\Tobii.EyeX.Client.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Visible="false" Include="..\libs\x32\TobiiGazeCore32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <Product>DrivingLab Server</Product>
    <Company>Tampere University</Company>
    <Authors>Oleg Spakov</Authors>
    <PackageId>DrivingLabServer</PackageId>
    <Description>DrivingLab Server</Description>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

</Project>