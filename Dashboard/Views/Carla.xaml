<UserControl x:Class="Dashboard.Views.Carla"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:widgets="clr-namespace:Dashboard.Widgets"
             xmlns:conv="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="280"
             d:DesignWidth="200">

    <UserControl.Resources>
        <conv:InvertBooleanConverter x:Key="InvertBoolean"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="Slider" BasedOn="{StaticResource MaterialDesign3.MaterialDesignSlider}">
                    <Setter Property="Minimum" Value="-1.0"/>
                    <Setter Property="Maximum" Value="1.0"/>
                    <Setter Property="TickFrequency" Value="0.001"/>
                    <Setter Property="SmallChange" Value="0.001"/>
                    <Setter Property="Foreground" Value="#FF5E6CB7"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
            </StackPanel.Resources>
            <Label Style="{StaticResource Device}"
                   Content="CARLA"/>
            <StackPanel>
                <widgets:Indicator IsOn="{Binding IsAvailable, Mode=OneWay}"
                                   Margin="8,0"
                                   Text="Available"/>
                <Separator/>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsStreaming}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Stream data"/>
                </WrapPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsLogging}"/>
                    <Label Style="{StaticResource RowHeader}"
                           Content="Log data"/>
                </WrapPanel>
                <Separator/>
                <Label>Fields</Label>
                <ScrollViewer MaxHeight="168"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding IsStreaming, Converter={StaticResource InvertBoolean}}">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Separator/>
                <TextBlock Style="{StaticResource Data}"
                           Text="{Binding Data, Mode=OneWay}"
                           Height="50"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
